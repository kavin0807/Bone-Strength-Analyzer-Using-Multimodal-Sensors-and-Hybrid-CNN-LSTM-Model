import os
import pandas as pd
import cv2
import random
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn import svm
import matplotlib.pyplot as plt
from sklearn.metrics import confusion_matrix, classification_report
import seaborn as sns
from sklearn import metrics
import tensorflow as tf
from tensorflow.python.keras.models import Sequential, Model
from tensorflow.python.keras.layers import Dense, Dropout, Activation, Flatten, Conv2D, MaxPooling2D

# Parameters
data_dir = "train"  # Update with your data directory
input_shape = (50, 50, 3)  # Image size
test_size = 0.1  

# Read the data
subfolders = os.listdir(data_dir)

data = []
for cls in subfolders:
    cls_dir = os.path.join(data_dir, cls)
    for img_name in os.listdir(cls_dir):
        img_path = os.path.join(cls_dir, img_name)
        data.append((img_path, cls))

# Split into train and test sets
train_data, test_data = train_test_split(data, test_size=test_size, random_state=42)

train_df = pd.DataFrame(train_data, columns=["image_path", "class"])
test_df = pd.DataFrame(test_data, columns=["image_path", "class"])

# Image preprocessing function
def preprocess_image(img_path):
    try:
        img_array = cv2.imread(img_path, 1)
        img_array = cv2.medianBlur(img_array, 1)
        new_array = cv2.resize(img_array, input_shape[:2])
        return new_array
    except Exception as e:
        return None

# Create training data
IMG_SIZE = input_shape[0]
training_data = []

for index, row in train_df.iterrows():
    img_path = row["image_path"]
    class_num = subfolders.index(row["class"])
    img_data = preprocess_image(img_path)
    if img_data is not None:
        training_data.append([img_data, class_num])

random.shuffle(training_data)

X = []  # Features
y = []  # Labels

for features, label in training_data:
    X.append(features)
    y.append(label)

X = np.array(X)
y = np.array(y)

# Normalize the data
X = X / 255.0

# Split the data into train and test sets
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.2, random_state=40)

# CNN model for feature extraction
cnn_model = Sequential()
cnn_model.add(Conv2D(32, (3, 3), input_shape=X.shape[1:]))
cnn_model.add(Activation("relu"))
cnn_model.add(MaxPooling2D(pool_size=(2, 2)))

cnn_model.add(Conv2D(64, (3, 3)))
cnn_model.add(Activation("relu"))
cnn_model.add(MaxPooling2D(pool_size=(2, 2)))

cnn_model.add(Conv2D(64, (3, 3)))
cnn_model.add(Activation("relu"))
cnn_model.add(MaxPooling2D(pool_size=(2, 2)))
cnn_model.add(Dropout(0.25))

cnn_model.add(Flatten())
cnn_model.add(Dense(128))
cnn_model.add(Activation("relu"))

cnn_model.add(Dense(128))
cnn_model.add(Activation("relu"))

# Output layer (we won't use this in feature extraction)
cnn_model.add(Dense(4))  # Assuming 4 classes
cnn_model.add(Activation("softmax"))

# Compile the CNN model
cnn_model.compile(loss="sparse_categorical_crossentropy", optimizer="adam", metrics=["accuracy"])

# Train the CNN model
history = cnn_model.fit(X, y, batch_size=32, epochs=10, validation_split=0.2)

# Save the trained CNN model
cnn_model.save('cnn_model.h5')

# Use CNN as a feature extractor (remove final output layers)
cnn_feature_extractor = Model(inputs=cnn_model.input, outputs=cnn_model.layers[-5].output)

# Extract features from training and test data using CNN
X_train_cnn_features = cnn_feature_extractor.predict(X_train)
X_test_cnn_features = cnn_feature_extractor.predict(X_test)

# Flatten the features for SVM input
X_train_cnn_features = X_train_cnn_features.reshape(X_train_cnn_features.shape[0], -1)
X_test_cnn_features = X_test_cnn_features.reshape(X_test_cnn_features.shape[0], -1)

# Normalize the features
X_train_cnn_features = X_train_cnn_features / 255.0
X_test_cnn_features = X_test_cnn_features / 255.0

# Train SVM on the CNN-extracted features
svm_model = svm.SVC(kernel='poly', C=1, probability=True)
svm_model.fit(X_train_cnn_features, y_train)

# Save the SVM model
import joblib
joblib.dump(svm_model, 'svm_model_cnn_features.pkl')

# Evaluate the SVM model
y_pred = svm_model.predict(X_test_cnn_features)
accuracy = metrics.accuracy_score(y_test, y_pred)
print(f'Accuracy: {accuracy * 100:.2f}%')

