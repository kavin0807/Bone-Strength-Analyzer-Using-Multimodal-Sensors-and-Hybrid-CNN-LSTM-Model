import tkinter as tk
from tkinter import messagebox, filedialog, ttk
import numpy as np
import joblib
import cv2
from tensorflow.keras.models import load_model
from tensorflow.keras.models import Model

# ==========================================
# ========== Load Models and Scalers =======
# ==========================================
# LSTM Bone Strength Model
lstm_model = load_model("bone_strength_lstm_model.h5")
scaler = joblib.load("scaler.pkl")
expected_features = scaler.mean_.shape[0]

# CNN + SVM Models for Fracture Detection
cnn_model = load_model("cnn_model.h5")
svm_model = joblib.load("svm_model_cnn_features.pkl")
cnn_feature_extractor = Model(inputs=cnn_model.input, outputs=cnn_model.layers[-5].output)

class_labels = {0: "fractured", 1: "not fractured"}


# ==========================================
# ========== Bone Strength Prediction ======
# ==========================================
def predict_strength():
    try:
        values = []
        for entry in sensor_entries:
            text = entry.get().strip()
            if text == "":
                messagebox.showerror("Input Error", "All fields must be filled with numeric values.")
                return
            values.append(float(text))

        if len(values) != expected_features:
            messagebox.showerror("Input Error", f"Expected {expected_features} features, got {len(values)}.")
            return

        input_data = np.array([values])
        input_scaled = scaler.transform(input_data)
        input_scaled = np.reshape(input_scaled, (input_scaled.shape[0], 1, input_scaled.shape[1]))

        prediction = lstm_model.predict(input_scaled)
        result = float(prediction[0][0])
        messagebox.showinfo("Prediction Result", f"Predicted Bone Strength: {result:.2f}")

    except Exception as e:
        messagebox.showerror("Unexpected Error", str(e))


# ==========================================
# ========== Fracture Detection ============
# ==========================================
def preprocess_image(img_path, img_size=(50, 50)):
    try:
        img_array = cv2.imread(img_path, 1)
        img_array = cv2.medianBlur(img_array, 1)
        new_array = cv2.resize(img_array, img_size)
        return new_array
    except Exception as e:
        print(f"Error processing image: {e}")
        return None


def predict_image_class(image_path):
    image = preprocess_image(image_path)
    if image is None:
        return "Error: Image could not be processed."

    image = image / 255.0
    image = np.expand_dims(image, axis=0)
    cnn_features = cnn_feature_extractor.predict(image)
    cnn_features = cnn_features.reshape(cnn_features.shape[0], -1)
    cnn_features = cnn_features / 255.0
    svm_prediction = svm_model.predict(cnn_features)
    return class_labels.get(svm_prediction[0], "Unknown Class")


def find_fracture(image_path):
    img = cv2.imread(image_path)
    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)
    blurred = cv2.GaussianBlur(gray, (5, 5), 0)
    thresh = cv2.adaptiveThreshold(blurred, 255, cv2.ADAPTIVE_THRESH_GAUSSIAN_C,
                                   cv2.THRESH_BINARY, 11, 2)
    contours, _ = cv2.findContours(thresh, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
    heatmap = np.zeros_like(gray, dtype=np.uint8)
    area_sum = 0
    for contour in contours:
        area = cv2.contourArea(contour)
        if area > 100:
            area_sum += area
            cv2.drawContours(heatmap, [contour], -1, int(min(area / 100, 255)), -1)

    heatmap_colored = cv2.applyColorMap(heatmap, cv2.COLORMAP_JET)
    heatmap_overlay = cv2.addWeighted(img, 0.5, heatmap_colored, 0.5, 0)
    cv2.imshow('Fracture Detection Heatmap', heatmap_overlay)
    cv2.waitKey(0)
    cv2.destroyAllWindows()
    return area_sum


def upload_image():
    file_path = filedialog.askopenfilename(title="Select X-ray Image",
                                           filetypes=[("Image Files", "*.jpg *.jpeg *.png")])
    if not file_path:
        return

    predicted_class = predict_image_class(file_path)

    if predicted_class == "fractured":
        area = find_fracture(file_path)
        area = area / 1000
        messagebox.showinfo("Result", f"🦴 Fractured Bone Detected\nAffected Level: {area:.2f}")
    else:
        messagebox.showinfo("Result", f"✅ Non-Fractured Bone Detected")


# ==========================================
# ========== GUI Layout (Tabbed UI) ========
# ==========================================
root = tk.Tk()
root.title("Bone Strength & Fracture Detection System")
root.geometry("500x600")

notebook = ttk.Notebook(root)
notebook.pack(expand=True, fill="both", pady=10)

# ----- TAB 1: Bone Strength Prediction -----
tab1 = ttk.Frame(notebook)
notebook.add(tab1, text="Bone Strength Prediction")

tk.Label(tab1, text="Enter Sensor Values", font=("Arial", 16, "bold")).pack(pady=10)
frame1 = tk.Frame(tab1)
frame1.pack(pady=5)

sensor_labels = ["Gyro X", "Gyro Y", "Gyro Z",
                 "Pressure", "Mid", "Back",
                 "Work", "Flux", "Heart Rate", "SpO2"]
sensor_entries = []

for i, label in enumerate(sensor_labels):
    tk.Label(frame1, text=f"{label}:").grid(row=i, column=0, sticky="w", pady=3)
    entry = tk.Entry(frame1)
    entry.grid(row=i, column=1, pady=3)
    sensor_entries.append(entry)

tk.Button(tab1, text="Predict Bone Strength", font=("Arial", 12, "bold"),
          command=predict_strength).pack(pady=15)

# ----- TAB 2: Fracture Detection -----
tab2 = ttk.Frame(notebook)
notebook.add(tab2, text="Fracture Detection")

tk.Label(tab2, text="Upload an X-ray Image", font=("Arial", 16, "bold")).pack(pady=20)
tk.Button(tab2, text="Upload Image", font=("Arial", 12, "bold"),
          command=upload_image).pack(pady=15)

# ==========================================
root.mainloop()
